# RPC Endpoints - comma-separated list of RPC_NAME=RPC_ENDPOINT pairs
RPC_ENDPOINTS=shannon=https://shannon-testnet-grove-api.beta.poktroll.com,mainnet=https://rpc.pokt.network
# RPC_ENDPOINTS=pocket-testnet-beta=https://shannon-testnet-grove-api.beta.poktroll.com
# ,pocket-mainnet=https://shannon-grove-api.mainnet.poktroll.com,pocket-testnet-alpha=https://shannon-testnet-grove-api.alpha.poktroll.com
RPC_URL=https://shannon-testnet-grove-api.beta.poktroll.com
CHAIN=pocket-mainnet

# Redis configuration
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TX_DETAIL=false
REDIS_TX_TTL_SEC=0
REDIS_RECENT_TTL_SEC=0
REDIS_INDEX_TXS=false

# Worker configuration
WORKER_CONCURRENCY=2
HISTORICAL_BATCH_SIZE=10
CLUSTER_WORKERS=4
PAGE_SIZE=50

# Block results workers
BLOCK_RESULTS_WORKER_COUNT=2
BLOCK_RESULTS_POLL_INTERVAL_MS=500
BLOCK_RESULTS_BATCH_SIZE=8
BLOCK_RESULTS_PARALLEL_LIMIT=10
BLOCK_RESULTS_RATE_LIMIT_MS=100
BLOCK_RESULTS_STATS_INTERVAL_MS=30000
BLOCK_RESULTS_ASYNC_EVENTS=true
BLOCK_RESULTS_LAG_BLOCKS=5
BLOCK_RESULTS_CURRENT_WINDOW_BLOCKS=50
BLOCK_RESULTS_LEASE_SCAN_COUNT=8
BLOCK_RESULTS_HEARTBEAT_INTERVAL_MS=60000
BLOCK_RESULTS_EVENT_CONCURRENCY=50
BLOCK_RESULTS_TX_LOG_BATCH_SIZE=50

# Monitoring and backfill
GAP_CHECK_INTERVAL_MS=30000
MONITOR_INTERVAL_MS=30000
HISTORICAL_HEARTBEAT_INTERVAL_MS=30000
HISTORICAL_RESTART_INTERVAL_MS=300000
EVENT_BACKFILL_BATCH_SIZE=100

# Memory management
TX_EXPIRE_TIME=2592000  # Transaction data expiration in seconds (30 days)
HISTORY_CACHE_TTL=3600  # History data cache TTL in seconds (1 hour)
NODE_HEAP_SIZE_MB=32768
MEMORY_WARNING_THRESHOLD_GB=12

# Performance tuning
PROCESSING_DELAY=100    # Delay between transaction batches to prevent Redis overload
REWARD_ANALYTICS_REFRESH_INTERVAL_MS=900000

# Database
DB_USER=postgres
DB_PASS=somestringpassword
DB_NAME=pocket_indexer
DB_HOST=postgres
DB_PORT=5432
DB_READ_HOST=
DB_READ_PORT=
DB_WRITE_HOST=
DB_WRITE_PORT=
DB_POOL_SIZE=10
DB_POOL_MIN=2
DATABASE_URL=
PG_DSN=

# Ports
PORT=3006
INDEXER_PORT=3007
PROOF_PARSER_PORT=3008

# Proof parser
PROOF_PARSER_POLL_INTERVAL=10000
PROOF_PARSER_BATCH_SIZE=100
PROOF_PARSER_HEALTH_CHECK_INTERVAL=5000

# Supplier enrichment and validator refresh
ENABLE_SUPPLIER_ENRICHMENT=false
SUPPLIER_ENRICHMENT_BATCH=200
SUPPLIER_ENRICHMENT_INTERVAL_MS=3600000
ENABLE_VALIDATOR_REFRESH=true
VALIDATOR_REFRESH_INTERVAL_MS=21600000

# Docker
DOCKER_HOST=

# Misc
NODE_ENV=development
VERBOSE=false
SAVE_RESULTS=false