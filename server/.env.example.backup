# RPC Endpoints - comma-separated list of RPC_NAME=RPC_ENDPOINT pairs
RPC_ENDPOINTS=shannon=https://shannon-testnet-grove-api.beta.poktroll.com,mainnet=https://rpc.pokt.network
# RPC_ENDPOINTS=pocket-testnet-beta=https://shannon-testnet-grove-api.beta.poktroll.com
# ,pocket-mainnet=https://shannon-grove-api.mainnet.poktroll.com,pocket-testnet-alpha=https://shannon-testnet-grove-api.alpha.poktroll.com
# Redis configuration
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# Worker configuration
WORKER_CONCURRENCY=2
HISTORICAL_BATCH_SIZE=10

# Memory management
TX_EXPIRE_TIME=2592000  # Transaction data expiration in seconds (30 days)
HISTORY_CACHE_TTL=3600  # History data cache TTL in seconds (1 hour)

# Performance tuning
PROCESSING_DELAY=100    # Delay between transaction batches to prevent Redis overload

# Database
DB_USER=postgres
DB_PASS=somestringpassword
DB_NAME=pocket_indexer
DB_HOST=postgres
DB_PORT=5432

PORT=3006
INDEXER_PORT=3007
GAP_CHECK_INTERVAL_MS=30000