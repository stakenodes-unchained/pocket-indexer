# Use the official Node.js image as base
FROM node:18

# Install PostgreSQL client tools
RUN apt-get update && apt-get install -y postgresql-client && rm -rf /var/lib/apt/lists/*

# Set the working directory inside the container
WORKDIR /usr/src/app

# Copy package.json and package-lock.json to the working directory
COPY package*.json ./

# Install dependencies with legacy-peer-deps flag to bypass dependency conflicts
RUN npm install --legacy-peer-deps

# Copy the rest of the application code to the working directory
COPY . .

# Make the startup script executable
RUN chmod +x start_indexer_server.sh

# Set Node.js environment to production
ENV NODE_ENV=production

# Node.js memory limit - configurable via NODE_HEAP_SIZE_MB env var
# Default to 32GB (32768 MB) for systems with 64GB RAM
# Can be overridden in docker-compose.yml or .env file
ARG NODE_HEAP_SIZE_MB=32768
ENV NODE_HEAP_SIZE_MB=${NODE_HEAP_SIZE_MB}
ENV NODE_OPTIONS="--max-old-space-size=${NODE_HEAP_SIZE_MB}"

# Change ownership of the working directory to the 'node' user
RUN chown -R node:node .

# Switch to the 'node' user for security
USER node

# Expose the port your app runs on
EXPOSE 3007

# Command to run the startup script
CMD ["./start_indexer_server.sh"]
