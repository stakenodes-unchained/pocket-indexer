# API node with local read-only PostgreSQL replica + API writes to primary

# API
PORT=3006
API_PORT=3016
CLUSTER_WORKERS=1
NODE_ENV=production

# Local Redis
REDIS_PORT=6378
REDIS_PASSWORD=
REDIS_DB=0

# Replica DB exposed port on host
REPLICA_DB_PORT=5433

# API DB credentials (API now points to primary for read/write consistency)
DB_USER=postgres
DB_PASS=somestringpassword
DB_NAME=pocket_indexer
DB_READ_HOST=postgres-replica
DB_READ_PORT=5432
DB_WRITE_HOST=primary-db-hostname-or-ip
DB_WRITE_PORT=5432

# Primary DB replication source
PRIMARY_DB_HOST=primary-db-hostname-or-ip
PRIMARY_DB_PORT=5432
PRIMARY_DB_REPL_USER=replicator
PRIMARY_DB_REPL_PASSWORD=replace-me
PRIMARY_DB_SSLMODE=prefer
REPLICA_APP_NAME=pocket_indexer_api_node
REPLICA_SLOT_NAME=pocket_api_node_slot